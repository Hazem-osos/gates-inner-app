components/
  layout/             # header-system, crm-nav, crm-shortcuts-ribbon, page-header
  clients/            # add/edit form, interactions, warming, pipeline, transfer dialogs
  reports/            # Report-B table, sales filters, warming/recommendations tables
  dashboard/          # shortcuts, mark-alert
  settings/           # classifications, users/passwords, backup manager
  admin/              # custom fields, core labels
  import/ export/     # Excel flows and export UI
  ui/                 # Shared primitives (button, card, table, dialog, …)
  providers/          # session-provider.tsx (NextAuth SessionProvider)

lib/
  prisma.ts           # Prisma singleton (global in dev)
  auth-helpers.ts     # getSessionUser, requireSessionUser, isAdmin, isManagerOrAdmin
  data/               # Query helpers (dashboard, clients, reports, custom fields, …)
  import/             # Excel import + normalize-arabic-text.ts
  export/             # Excel/PDF export helpers
  mappers/            # Data mapping utilities
  audit/              # AuditLog helpers
  report-b-*.ts       # Report-B specific logic
  report-scope.ts
  validations/        # Zod schemas (e.g. add-client.ts)
  db/                 # MySQL direct helpers (parse URL, client defaults, backup)

prisma/
  schema.prisma       # Source of truth for all models
  seed.ts

auth.ts               # NextAuth config (credentials, JWT callbacks, roles)
middleware.ts         # Protects /dashboard /clients /admin /reports /warming
types/next-auth.d.ts  # Session extensions (id, role: UserRole)
scripts/              # DB utilities, imports, wipes, seeds
