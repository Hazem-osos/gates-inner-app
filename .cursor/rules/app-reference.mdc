    warming/
    reports/          # b, not-b, closed, won, recommendations, calls, warming, transferred
    settings/         # field-labels, users, backup
    admin/            # custom-fields, core-labels
  login/ register/    # outside (crm) group
  api/                # Route handlers (auth, import, export, backup, etc.)
