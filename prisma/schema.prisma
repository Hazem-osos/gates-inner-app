generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  SALES
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  role         UserRole @default(SALES)
  isActive     Boolean  @default(true)
  /// إفراغه = مستخدم مفعّل؛ تاريخ = حذف ناعم (السجلات تبقى مرتبطة ويُعرض «مستخدم محذوف»)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedClients Client[] @relation("ClientAssignedSales")

  authoredRecommendations   ManagementRecommendation[] @relation("RecommendationAuthor")
  targetedRecommendations ManagementRecommendation[] @relation("RecommendationTarget")

  interactionsCreated Interaction[]        @relation("InteractionCreatedBy")
  statusChanges       ClientStatusChange[] @relation("StatusChangedBy")
  alerts              Alert[]
  auditLogs           AuditLog[]
  transfersFrom       ClientTransfer[]       @relation("TransferFromUser")
  transfersTo         ClientTransfer[]       @relation("TransferToUser")
  reportRowStyles     ReportRowStyle[]
  newLeadsEntered     NewLead[]        @relation("NewLeadCreatedBy")

  /// قوائم السيلز للفلتر، إعدادات المستخدم: role + isActive + deletedAt
  @@index([role, isActive, deletedAt])
}

enum ClientStatus {
  B
  NOT_B
  WON
  LOST
}

/// تصنيفات العميل الديناميكية (B، U، C، Z، موزع، …)
model ClientClassification {
  id    String @id @default(cuid())
  /// مفتاح ثابت للبذرة والتمييز — لا يُعرض للمستخدم
  slug  String @unique
  label String
  /// لون عرض (Hex أو مفتاح Tailwind)
  color String
  /// ترتيب الظهور
  sortOrder Int @default(0)

  /// إذا true يُمثل صف «عميل B» ويُضبط عند الاختيار Client.status = B
  isBRow Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]

  @@index([sortOrder])
}

model Client {
  id              String       @id @default(cuid())
  name            String
  phone           String
  phone2          String?
  company         String?
  position        String?
  address         String?
  quotePrice      Decimal?     @db.Decimal(14, 2)
  quoteDetail     String?      @db.Text
  allowedDiscount Decimal?     @db.Decimal(7, 2)
  status          ClientStatus @default(NOT_B)

  /// اسم الإعلان
  sourceAdName String?
  /// المنصة الإعلانية (منفصل عن اسم الإعلان)
  adPlatform String?

  initialCallDate DateTime?
  nextFollowUpAt  DateTime?

  /// تصنيف فرعي لعملاء Not B — يُفضّل تخزين معرّف ClientClassification الفرعي كنص
  notBClassification String?

  classificationId String?
  classification   ClientClassification? @relation(fields: [classificationId], references: [id])

  /// النشاط (تقارير)
  activity String?

  /// توصيات اجتماع الإدارة + التاريخ (تقرير B)
  managementRecommendationText String?   @db.Text
  managementRecommendationDate   DateTime?

  /// الموقف الحالي (يمكن عرضه مع ملخص المكالمة في خلية واحدة)
  currentSituation String? @db.Text

  /// QQ: نعم = true، لا = false
  qqAnswer Boolean?

  callSummary String? @db.Text
  salesNotes  String? @db.Text
  /// نص أدوات Warming على بطاقة العميل (إضافة عميل)
  clientWarmingText String? @db.Text

  visitAppointmentScheduled Boolean   @default(false)
  visitAppointmentDate      DateTime?

  /// موظف العرض — نص يدوي من المستخدم
  presentingEmployeeName String?

  /// متابعات ديناميكية: مصفوفة JSON [{ "order": number, "note": string, "date": string ISO }]
  followUpSlots Json @default("[]") @db.Json

  /// ملخص ما تم في الزيارة — عمود التقارير (B / Not B)
  finalStatusNote String? @db.Text

  customFields Json @default("{}") @db.Json

  assignedUserId String?
  assignedUser   User?   @relation("ClientAssignedSales", fields: [assignedUserId], references: [id])

  contractValue Decimal?  @db.Decimal(14, 2)
  saleDate      DateTime?

  lossReason   String?   @db.Text
  closedLostAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interactions    Interaction[]
  recommendations ManagementRecommendation[]
  warmingTools    WarmingToolSent[]
  statusHistory   ClientStatusChange[]
  alerts          Alert[]
  auditLogs       AuditLog[]
  transfers       ClientTransfer[]
  reportStyles    ReportRowStyle[]
  newLeadSource   NewLead[]        @relation("ClientFromNewLead")

  /// ترتيب/فلترة: لوحات B/Not B، تقارير، قائمة العملاء (مع assignedUser)
  @@index([status, nextFollowUpAt])
  /// فلترة + فرز createdAt (قائمة العملاء، نطاق سيلز)
  @@index([assignedUserId, status, createdAt])
  /// تقارير المكالمات / الفرز الزمني
  @@index([initialCallDate])
  /// بحث/تعريف بالهاتف، استيراد، جلب بالرقم
  @@index([phone])
  /// انضمام التصنيف + groupBy في الإحصائيات
  @@index([classificationId])
  /// تقرير «المغلقين» والعملاء LOST
  @@index([closedLostAt])
  /// فرز إداري: آخر دخول أولاً/طلبات حديثة
  @@index([createdAt])
}

model Interaction {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  interactionAt  DateTime
  notes            String   @db.Text
  followUpStatus   String?
  nextFollowUpAt   DateTime
  createdById      String?
  createdBy        User?    @relation("InteractionCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([clientId, interactionAt])
  @@index([nextFollowUpAt])
  /// تقارير/سجلات بمُدخل المتابعة
  @@index([createdById, interactionAt])
}

model ManagementRecommendation {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  body String @db.Text

  authorId String
  author   User   @relation("RecommendationAuthor", fields: [authorId], references: [id])

  targetUserId String
  targetUser   User   @relation("RecommendationTarget", fields: [targetUserId], references: [id])

  acknowledgedAt DateTime?

  /// تاريخ التوصية (قابل للتعديل من التقرير؛ إن وُجد null يُعرض createdAt)
  recommendationDate DateTime?

  /// تاريخ العمل بالتوصية (يدوي من التقرير)
  workDate    DateTime?
  /// الإجراء المتخذ
  actionTaken String?   @db.Text

  createdAt DateTime @default(now())

  alert Alert?

  @@index([targetUserId, createdAt])
  @@index([clientId, createdAt])
  /// تتبع حسب مُوصي الإدارة
  @@index([authorId, createdAt])
}

enum AlertType {
  MANAGEMENT_RECOMMENDATION
  OVERDUE_FOLLOWUP
}

model Alert {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   AlertType

  title   String
  message String? @db.Text

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  recommendationId String? @unique
  recommendation   ManagementRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
}

model WarmingToolSent {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  communicatedAt   DateTime?
  activitySnapshot String?

  day1Content String? @db.Text
  day2Content String? @db.Text
  day3Content String? @db.Text

  /// تم إرسال أدوات اليوم N (تبديل تم/لم يتم)
  day1Done Boolean @default(false)
  day2Done Boolean @default(false)
  day3Done Boolean @default(false)

  notes String? @db.Text

  createdAt DateTime @default(now())

  @@index([clientId, communicatedAt])
}

/// سجل إجراءات للعميل (زر «سجل العمل» والتعديلات المهمة)
model AuditLog {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// كيان عام (Client، Report، …)
  entity   String?
  entityId String?

  kind    String // e.g. CELL_EDIT, STATUS_CHANGE, IMPORT
  action  String?
  summary String @db.Text
  meta    Json?  @db.Json

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId, createdAt])
}

/// نقل عميل بين مندوبي المبيعات
model ClientTransfer {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  fromUserId String?
  fromUser   User?   @relation("TransferFromUser", fields: [fromUserId], references: [id])

  toUserId String
  toUser   User    @relation("TransferToUser", fields: [toUserId], references: [id])

  /// «تم الاطلاع» من المندوب الجديد
  acknowledgedAt DateTime?

  createdAt DateTime @default(now())

  @@index([toUserId, acknowledgedAt])
  @@index([clientId, createdAt])
}

/// تلوين صف التقرير — مشترك لجميع المستخدمين (نفس العميل + نفس التقرير).
/// userId = من طبّق أو عدّل اللون آخر مرة (تدقيق فقط).
model ReportRowStyle {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  reportKey String // e.g. report-b
  clientId  String
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  colorKey   String // e.g. red | yellow | blue (قديم: green يُعرض كأزرق)
  legendNote String?

  @@unique([reportKey, clientId])
  @@index([reportKey])
  @@index([userId])
}

model ClientStatusChange {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  fromStatus ClientStatus?
  toStatus   ClientStatus

  note String? @db.Text

  changedById String?
  changedBy   User?   @relation("StatusChangedBy", fields: [changedById], references: [id])

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

enum CustomFieldValueType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

model CustomFieldDefinition {
  id    String @id @default(cuid())
  key   String @unique
  labelAr String

  valueType CustomFieldValueType @default(TEXT)

  options Json? @db.Json

  isRequired Boolean @default(false)
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

/// Arabic labels for fixed Client columns (admin-editable display layer)
model CoreFieldLabel {
  id        String   @id @default(cuid())
  fieldKey  String   @unique
  labelAr   String
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, sortOrder])
}

enum NewLeadReachStatus {
  NOT_REACHED
  REACHED
}

/// ليدات يومية — قبل إنشاء بطاقة عميل (هاتف + إعلان، مع تسجيل السيلز)
model NewLead {
  id          String   @id @default(cuid())
  /// YYYY-MM-DD — يوم العمل في اللوحة
  entryYmd    String
  phone       String
  /// نص الإعلان (اسم أو وصف مختصر)
  adText      String   @db.VarChar(512)

  reachStatus  NewLeadReachStatus @default(NOT_REACHED)
  /// تصنيف التقرير: B | C | Z | EXPIRED — فارغ افتراضياً
  leadCategory String?            @db.VarChar(32)

  clientId String?
  client   Client? @relation("ClientFromNewLead", fields: [clientId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User     @relation("NewLeadCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entryYmd, createdAt])
  @@index([createdById, entryYmd])
  @@index([clientId])
  @@index([reachStatus, entryYmd])
}
